        "import math\n",
        "import random\n",
        "from dataclasses import dataclass\n",
        "\n",
        "# Placeholder for _greedy_split, as its definition was not provided\n",
        "def _greedy_split(text: str, vocab: dict) -> list[str]:\n",
        "    \"\"\"\n",
        "    Placeholder function for splitting text into tokens based on a vocabulary.\n",
        "    This implementation splits the text by spaces to simulate tokenization.\n",
        "\n",
        "    Args:\n",
        "        text: The input text string.\n",
        "        vocab: A dictionary representing the tokenizer's vocabulary (not used in this placeholder).\n",
        "\n",
        "    Returns:\n",
        "        A list of token strings.\n",
        "    \"\"\"\n",
        "    return text.split()\n",
        "\n",
        "@dataclass\n",
        "class ContextPlan:\n",
        "    kept: list[str]\n",
        "    dropped: list[str]\n",
        "    rejected: bool = False\n",
        "    reason: str = \"\"\n",
        "\n",
        "def count_tokens(text: str, tokenizer: dict) -> int:\n",
        "  #1-------\n",
        "  #Return the NUMBER OF TOKENS `text` produces under `tokenizer`.\n",
        "    \"\"\"\n",
        "    Counts the number of tokens a given text produces under a specified tokenizer.\n",
        "\n",
        "    Args:\n",
        "        text: The input text string.\n",
        "        tokenizer: A dictionary containing tokenizer information, specifically a 'vocab' key.\n",
        "\n",
        "    Returns:\n",
        "        The number of tokens in the text.\n",
        "    \"\"\"\n",
        "    tokens = _greedy_split(text, tokenizer[\"vocab\"])\n",
        "    return len(tokens)\n",
        "\n",
        "\n",
        "def prepare_context(messages: list[str], context_limit: int, reserved_output: int,\n",
        "                    tokenizer: dict, strategy: str = \"drop_oldest\") -> ContextPlan:\n",
        "  #2-----------------\n",
        "  #Fit `messages` into an explicit token budget and RECORD what happened.\n",
        "    \"\"\"\n",
        "    Prepares a context by fitting a list of messages into a token budget,\n",
        "    applying different strategies to handle overflow.\n",
        "\n",
        "    Args:\n",
        "        messages: A list of message strings to be included in the context.\n",
        "        context_limit: The maximum total tokens allowed for the context.\n",
        "        reserved_output: Tokens reserved for the output, reducing the available budget.\n",
        "        tokenizer: A dictionary containing tokenizer information to count tokens.\n",
        "        strategy: The strategy to use for managing context overflow. Options are:\n",
        "            - \"reject\": If total tokens exceed the budget, the plan is rejected.\n",
        "            - \"drop_oldest\": Drops messages starting from the oldest (index 1) until the budget is met.\n",
        "                             The system message (index 0) is always kept.\n",
        "            - \"drop_random\": Randomly drops messages (excluding the system message) until the budget is met.\n",
        "\n",
        "    Returns:\n",
        "        A ContextPlan object detailing which messages were kept and dropped,\n",
        "        and if the plan was rejected due to budget constraints.\n",
        "    \"\"\"\n",
        "    budget = context_limit - reserved_output\n",
        "    # total_tokens is calculated per strategy to avoid redundant computation\n",
        "\n",
        "    if strategy == \"reject\":\n",
        "        total_tokens = sum(count_tokens(m, tokenizer) for m in messages)\n",
        "        if total_tokens > budget:\n",
        "            return ContextPlan(\n",
        "                kept=[],\n",
        "                dropped=[],\n",
        "                rejected=True,\n",
        "                reason=f\"Total input ({total_tokens} tokens) exceeds budget ({budget} tokens).\"\n",
        "            )\n",
        "        return ContextPlan(kept=list(messages))\n",
        "\n",
        "    elif strategy == \"drop_oldest\":\n",
        "        kept = list(messages)\n",
        "        dropped = []\n",
        "\n",
        "        # Always keep system message (messages[0]), drop the next-oldest (index 1) until it fits\n",
        "        while len(kept) > 1 and sum(count_tokens(m, tokenizer) for m in kept) > budget:\n",
        "            dropped.append(kept.pop(1))\n",
        "\n",
        "        final_tokens = sum(count_tokens(m, tokenizer) for m in kept)\n",
        "        if final_tokens > budget:\n",
        "            return ContextPlan(\n",
        "                kept=kept,\n",
        "                dropped=dropped,\n",
        "                rejected=True,\n",
        "                reason=\"Context limit exceeded even after dropping all non-system messages.\"\n",
        "            )\n",
        "\n",
        "        return ContextPlan(kept=kept, dropped=dropped, rejected=False)\n",
        "\n",
        "    elif strategy == \"drop_random\":\n",
        "        messages_with_info = [(m, count_tokens(m, tokenizer)) for m in messages]\n",
        "        current_token_sum = sum(pair[1] for pair in messages_with_info)\n",
        "\n",
        "        kept_indices = list(range(len(messages_with_info)))\n",
        "        dropped_messages = []\n",
        "\n",
        "        # Prepare a list of indices that can be randomly dropped (all except the first system message)\n",
        "        droppable_indices_candidates = list(range(len(messages_with_info)))\n",
        "        if droppable_indices_candidates:\n",
        "            if len(droppable_indices_candidates) > 0: # Ensure there's an index 0 to remove\n",
        "                droppable_indices_candidates.pop(0) # Remove index 0 (system message) from candidates\n",
        "\n",
        "        random.shuffle(droppable_indices_candidates) # Shuffle the indices of droppable messages\n",
        "\n",
        "        # Iterate through shuffled droppable indices and drop messages until budget is met\n",
        "        for original_idx_to_drop in droppable_indices_candidates:\n",
        "            if current_token_sum <= budget or len(kept_indices) <= 1:\n",
        "                # Budget met, or only the system message is left (and cannot be dropped)\n",
        "                break\n",
        "\n",
        "            msg_content, msg_tokens = messages_with_info[original_idx_to_drop]\n",
        "            current_token_sum -= msg_tokens\n",
        "            dropped_messages.append(msg_content)\n",
        "            kept_indices.remove(original_idx_to_drop) # Mark this message as not kept\n",
        "\n",
        "        kept = [messages_with_info[i][0] for i in sorted(kept_indices)] # Reconstruct kept messages, preserving order\n",
        "\n",
        "        rejected = False\n",
        "        reason = \"\"\n",
        "        if current_token_sum > budget:\n",
        "            rejected = True\n",
        "            reason = \"Context limit exceeded even after dropping all non-system messages using random strategy.\"\n",
        "\n",
        "        return ContextPlan(kept=kept, dropped=dropped_messages, rejected=rejected, reason=reason)\n",
        "\n",
        "    raise ValueError(f\"Unknown strategy: {strategy}\")\n",
        "\n",
        "\n",
        "def sample_next(distribution: dict[str, float], temperature: float,\n",
        "                rng: random.Random) -> str:\n",
        "   #3------------\n",
        "  #Return ONE token sampled from `distribution` (token -> probability).\n",
        "    \"\"\"\n",
        "    Samples a single token from a given probability distribution.\n",
        "\n",
        "    Args:\n",
        "        distribution: A dictionary where keys are token strings and values are their probabilities.\n",
        "        temperature: A float controlling the randomness of the sampling:\n",
        "            - temperature <= 0: Performs greedy sampling (picks the token with the highest probability).\n",
        "                                 In case of ties, tokens are sorted alphabetically.\n",
        "            - temperature > 0: Applies softmax scaling to probabilities and samples based on the new distribution.\n",
        "        rng: A random.Random object for deterministic random number generation.\n",
        "\n",
        "    Returns:\n",
        "        The sampled token string.\n",
        "\n",
        "    Raises:\n",
        "        ValueError: If the input distribution is empty or if it leads to all zero probabilities after scaling.\n",
        "    \"\"\"\n",
        "    if not distribution:\n",
        "        raise ValueError(\"Cannot sample from an empty distribution.\")\n",
        "\n",
        "    # Temperature <= 0: Greedy search / Argmax with alphabetical tie-breaking\n",
        "    if temperature <= 0:\n",
        "        max_prob = max(distribution.values())\n",
        "        top_candidates = [token for token, prob in distribution.items() if prob == max_prob]\n",
        "        top_candidates.sort()  # Tie-breaker: alphabetically first\n",
        "        return top_candidates[0]\n",
        "\n",
        "    # Temperature > 0: Softmax scaling and cumulative sampling\n",
        "    tokens = list(distribution.keys())\n",
        "    # Convert probabilities to log-space (logits)\n",
        "    logits = [math.log(distribution[tok]) if distribution[tok] > 0 else -float('inf') for tok in tokens]\n",
        "\n",
        "    if not logits or all(l == -float('inf') for l in logits):\n",
        "        # All probabilities are zero or effectively zero. Fallback.\n",
        "        if tokens:\n",
        "            probs = [1.0 / len(tokens)] * len(tokens)\n",
        "        else:\n",
        "            raise ValueError(\"Distribution contains no tokens.\")\n",
        "    else:\n",
        "        max_logit = max(logits)\n",
        "        # Apply temperature and subtract max_logit for numerical stability\n",
        "        scaled_logits = [(l / temperature) - max_logit for l in logits]\n",
        "        scaled_exp = [math.exp(sl) for sl in scaled_logits]\n",
        "        sum_exp = sum(scaled_exp)\n",
        "\n",
        "        if sum_exp == 0:\n",
        "            # This implies all scaled_exp were effectively zero, e.g., due to very low temperature\n",
        "            # or extreme negative logits. Fallback to uniform if tokens exist.\n",
        "            if tokens:\n",
        "                probs = [1.0 / len(tokens)] * len(tokens)\n",
        "            else:\n",
        "                raise ValueError(\"Distribution resulted in all zero probabilities after scaling.\")\n",
        "        else:\n",
        "            probs = [e / sum_exp for e in scaled_exp]\n",
        "\n",
        "    # Cumulative distribution sampling with deterministic rng\n",
        "    r = rng.random()\n",
        "    cumulative = 0.0\n",
        "    for token, prob in zip(tokens, probs):\n",
        "        cumulative += prob\n",
        "        if r <= cumulative:\n",
        "            return token\n",
        "\n",
        "    # Fallback in case of floating point inaccuracies or edge cases\n",
        "    return tokens[-1] if tokens else None"
      ]
